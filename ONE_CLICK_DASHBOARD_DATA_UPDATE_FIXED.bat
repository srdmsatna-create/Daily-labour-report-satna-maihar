@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
title SRDM ALL REPORTS v14 - One Click Live Update
where py >nul 2>&1
if errorlevel 1 (set "SRDM_PY=python") else (set "SRDM_PY=py -3")
%SRDM_PY% -u -c "import pathlib,sys,base64;s=pathlib.Path(sys.argv[1]).read_text(encoding='ascii');exec(compile(base64.b64decode(s.split('REM ALL_REPORTS_'+'PAYLOAD',1)[1].strip()),sys.argv[1],'exec'))" "%~f0" "%~1"
set "SRDM_RESULT=%ERRORLEVEL%"
if /i "%~1"=="--scheduled" exit /b %SRDM_RESULT%
if /i "%~1"=="--no-pause" exit /b %SRDM_RESULT%
pause
exit /b %SRDM_RESULT%
REM ALL_REPORTS_PAYLOAD


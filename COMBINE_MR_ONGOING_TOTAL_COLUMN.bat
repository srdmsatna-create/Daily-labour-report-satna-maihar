@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "SRDM_PY=py"
where py >nul 2>&1
if errorlevel 1 set "SRDM_PY=python"
"%SRDM_PY%" -c "import pathlib,sys; p=pathlib.Path(sys.argv[1]); exec(compile(p.read_text(encoding='utf-8').split(chr(35)+' SRDM_UI_FIX',1)[1],str(p),'exec'))" "%~f0" "%~dp0."
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" echo FAILED: Fix was not confirmed. See error above.
pause
exit /b %RESULT%
# SRDM_UI_FIX
import sys, pathlib, base64, subprocess, tempfile, shutil
repo=pathlib.Path(sys.argv[2]).resolve()
def run(args,cwd=repo):
 subprocess.run(args,cwd=cwd,check=True)
if not (repo/'.git').exists(): raise RuntimeError('Keep this BAT in the main dashboard Git folder.')
content=base64.b64decode('')
run(['git','fetch','origin','main'])
folder=pathlib.Path(tempfile.mkdtemp(prefix='srdm-ui-'));folder.rmdir()
added=False
try:
 run(['git','worktree','add','--detach',str(folder),'FETCH_HEAD']);added=True
 (folder/'gp-labour-muster-module.js').write_bytes(content)
 run(['git','add','--','gp-labour-muster-module.js'],folder)
 changed=subprocess.run(['git','diff','--cached','--quiet'],cwd=folder).returncode
 if changed==0: print('SUCCESS: UI fix already published.')
 elif changed==1:
  run(['git','commit','-m','Combine total issued MR and ongoing work columns'],folder)
  run(['git','push','origin','HEAD:main'],folder)
  print('SUCCESS: Separate total columns replaced with issued MR / ongoing work total. Refresh website with Ctrl+Shift+R after deployment.')
 else: raise RuntimeError('Git diff failed')
finally:
 if added: run(['git','worktree','remove',str(folder)])

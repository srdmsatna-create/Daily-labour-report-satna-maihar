where node >nul 2>nul
if not errorlevel 1 (
  node --check "shramik-niyojan.js"
  if errorlevel 1 (
    echo ERROR: JavaScript validation failed. Restoring backup...
    copy /Y "shramik-niyojan.before_compact_filter.bak.js" "shramik-niyojan.js" >nul
    pause
    exit /b 1
  )
)
echo [3/5] Validation passed.


  echo ERROR: Updated file decode nahi ho saki.
  del /Q "%B64_FILE%" 2>nul
  pause
  exit /b 1
)
del /Q "%B64_FILE%" 2>nul

move /Y "%NEW_FILE%" "shramik-niyojan.js" >nul
if errorlevel 1 (
  echo ERROR: shramik-niyojan.js replace nahi ho saki.
  pause
  exit /b 1
)

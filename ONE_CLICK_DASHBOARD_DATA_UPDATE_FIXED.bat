@echo off
setlocal EnableExtensions DisableDelayedExpansion
title SRDM SATNA - One Click Data Update and 8AM Timer v11 - UTF-8 Fix and Automatic Yuktdhara Refresh
set "SRDM_PY="
where py >nul 2>nul
if not errorlevel 1 set "SRDM_PY=py"
if not defined SRDM_PY (
  where python >nul 2>nul
  if not errorlevel 1 set "SRDM_PY=python"
)
if not defined SRDM_PY (
  echo ERROR: Python is not available.
  pause
  exit /b 1
)
"%SRDM_PY%" -c "import pathlib,sys; p=pathlib.Path(sys.argv[1]); exec(compile(p.read_text(encoding='utf-8').split(chr(35)+' SRDM_PYTHON_START',1)[1],str(p),'exec'))" "%~f0" "%~dp0." "%~1"
set "SRDM_RESULT=%ERRORLEVEL%"
if not "%SRDM_RESULT%"=="0" echo FAILED - See the error above. Do not assume the website was updated.
if /i not "%~1"=="--no-pause" pause
exit /b %SRDM_RESULT%
# SRDM_PYTHON_START
import os, sys, subprocess, tempfile, shutil, datetime, time, json, base64
from pathlib import Path
FILES = ['auto-data.js','auto-status.js','data/fetch-status.json','data/official-summary.csv','muster-emb-data.js','shramik-niyojan-data.js','vbg-block-stats.js','yuktdhara-data.js','yuktdhara-official-data.js','shramik-district-reports.js','shramik-state-refresh-status.js','yuktdhara-received-data.js']

def run(args, cwd, env=None, capture=False):
    p = subprocess.run(args, cwd=cwd, env=env, stdout=subprocess.PIPE if capture else None, stderr=subprocess.PIPE if capture else None, text=True, encoding='utf-8', errors='strict')
    if p.returncode:
        raise RuntimeError('Command failed: '+ ' '.join(map(str,args)) + ('\n'+p.stderr if capture else ''))
    return p.stdout.strip() if capture else ''

def publish(repo, snapshot, files, gitdir):
    # Build a commit on the fetched main without checking out, resetting,
    # rebasing, or changing the user's index or branch.
    for attempt in range(1,4):
        run(['git','fetch','origin','refs/heads/main'],repo)
        base=run(['git','rev-parse','FETCH_HEAD'],repo,capture=True)
        index=gitdir/('srdm-publish-index-'+next(tempfile._get_candidate_names()))
        env=os.environ.copy(); env['GIT_INDEX_FILE']=str(index)
        try:
            run(['git','read-tree',base],repo,env)
            for name in files:
                blob=run(['git','hash-object','-w',str(snapshot/name)],repo,capture=True)
                mode='100644'
                entry=run(['git','ls-tree',base,'--',name],repo,capture=True)
                if entry: mode=entry.split()[0]
                run(['git','update-index','--add','--cacheinfo',mode,blob,name],repo,env)
            tree=run(['git','write-tree'],repo,env,capture=True)
            old=run(['git','rev-parse',base+'^{tree}'],repo,capture=True)
            if tree==old:
                print('GitHub already contains this data. Commit: '+base,flush=True)
                return base
            commit=run(['git','commit-tree',tree,'-p',base,'-m','Daily dashboard data '+datetime.datetime.now().isoformat(timespec='seconds')],repo,capture=True)
            p=subprocess.run(['git','push','origin',commit+':refs/heads/main'],cwd=repo)
            if p.returncode==0:
                print('GITHUB PUSH SUCCESS: '+commit,flush=True)
                return commit
            print('Push failed; fetching current main before retry '+str(attempt)+'/3.',flush=True)
        finally:
            index.unlink(missing_ok=True)
            Path(str(index)+'.lock').unlink(missing_ok=True)
    raise RuntimeError('GitHub publish failed after 3 attempts. Data snapshot is preserved.')

def install_timer(repo):
    if os.name != 'nt': return
    if len(sys.argv)>3 and sys.argv[3].lower()=='--no-pause': return
    print('Checking/installing daily 8 AM India timer...',flush=True)
    ps = 'param([string]$Folder)\n$ErrorActionPreference=\'Stop\'\ntry {\n    $Folder=[IO.Path]::GetFullPath($Folder)\n    $updater=Join-Path $Folder \'ONE_CLICK_DASHBOARD_DATA_UPDATE_FIXED.bat\'\n    if (!(Test-Path -LiteralPath $updater)) { throw \'Place this setup BAT next to ONE_CLICK_DASHBOARD_DATA_UPDATE_FIXED.bat in the dashboard folder.\' }\n    $zone=Get-TimeZone\n    if ($zone.Id -ne \'India Standard Time\') { throw \'Set Windows timezone to India (UTC+05:30), then run this setup again. The timer uses Windows local time.\' }\n    $user=[Security.Principal.WindowsIdentity]::GetCurrent().Name\n    $log=Join-Path $Folder \'daily-update.log\'\n    $arguments=\'/d /s /c ""\'+$updater+\'" --no-pause >> "\'+$log+\'" 2>&1"\'\n    $action=New-ScheduledTaskAction -Execute $env:ComSpec -Argument $arguments -WorkingDirectory $Folder\n    $trigger=New-ScheduledTaskTrigger -Daily -At \'08:00\'\n    $settings=New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 10) -ExecutionTimeLimit (New-TimeSpan -Hours 2)\n    $principal=New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited\n    $name=\'SRDM SATNA - Daily Dashboard 8AM\'\n    $existing=Get-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue\n    if ($existing -and $existing.State -ne \'Disabled\' -and $existing.Actions.Arguments -eq $arguments) { Write-Host \'Daily 8 AM timer already installed.\'; exit 0 }\n    Register-ScheduledTask -TaskName $name -Action $action -Trigger $trigger -Settings $settings -Principal $principal -Description \'Fetch dashboard data and publish to GitHub daily at 8 AM India time; catch up missed runs when available.\' -Force | Out-Null\n    $task=Get-ScheduledTask -TaskName $name\n    $info=Get-ScheduledTaskInfo -TaskName $name\n    if ($task.State -eq \'Disabled\') { throw \'Task is disabled.\' }\n    Write-Host \'SUCCESS: Daily 08:00 AM India timer installed.\'\n    Write-Host (\'Next run: \'+$info.NextRunTime)\n    Write-Host (\'Log: \'+$log)\n    Write-Host \'Missed runs: StartWhenAvailable enabled. Stay signed in; laptop and internet must be available.\'\n    Write-Host \'Setup is complete. You do not need to run this installer daily.\'\n    exit 0\n} catch {\n    Write-Host (\'ERROR: \'+$_.Exception.Message)\n    Write-Host \'Timer installation was NOT confirmed.\'\n    exit 1\n}\n'
    env=os.environ.copy(); env['SRDM_SETUP_FOLDER']=str(repo)
    command="& {"+ps+"} $env:SRDM_SETUP_FOLDER"
    run(['powershell.exe','-NoProfile','-ExecutionPolicy','Bypass','-Command',command],repo,env)

def main(repo):
    repo=Path(repo).resolve()
    if not shutil.which('git'): raise RuntimeError('Git is not installed.')
    gitdir=Path(run(['git','rev-parse','--absolute-git-dir'],repo,capture=True))
    install_timer(repo)
    lock=gitdir/'srdm-one-click.lock'
    try: lock.mkdir()
    except FileExistsError: raise RuntimeError('Another updater is running, or a previous run was interrupted. Lock: '+str(lock))
    stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup=gitdir/'srdm-update-backups'/stamp
    backup.mkdir(parents=True)
    before=backup/'before'; snapshot=backup/'publish'
    existed={name:(repo/name).is_file() for name in FILES}
    try:
        print('Backup: '+str(backup),flush=True)
        for name in FILES:
            if existed[name]:
                (before/name).parent.mkdir(parents=True,exist_ok=True)
                shutil.copy2(repo/name,before/name)
        candidates=['local_auto_update.py','scripts_local/local_auto_update.py','scripts/local_auto_update.py']
        updater=next((x for x in candidates if (repo/x).is_file()),None)
        if not updater: raise RuntimeError('local_auto_update.py not found. Place this BAT inside the dashboard repository.')
        # Provision required reference files only when absent; never overwrite local references.
        reference_assets={'shramik-fy2526-fixed-baseline.json': '', 'shramik-district-reports.js': ''}
        for name,encoded in reference_assets.items():
            target=repo/name
            if not target.is_file():
                target.write_bytes(base64.b64decode(encoded))
                print('Installed missing reference: '+name,flush=True)
        baseline=json.loads((repo/'shramik-fy2526-fixed-baseline.json').read_text(encoding='utf-8-sig'))
        if len(baseline.get('rows',[]))!=52: raise RuntimeError('Fixed baseline must contain 52 districts.')
        state_script=repo/'scripts_local/update_shramik_state.py'
        if state_script.is_file():
            shutil.copy2(state_script,backup/'previous-update_shramik_state.py')
        if True:
            state_script.parent.mkdir(parents=True,exist_ok=True)
            state_script.write_bytes(base64.b64decode(''))
        received_script=repo/'scripts_local/update_yuktdhara_received.py'
        received_script.write_bytes(base64.b64decode(''))
        # Refresh the GP scraper from the project's main branch on every run.
        # Future portal-link corrections no longer require replacing this BAT.
        try:
            run(['git','fetch','origin','refs/heads/main'],repo)
            latest=run(['git','show','FETCH_HEAD:scripts_local/update_yuktdhara_received.py'],repo,capture=True)
            compile(latest,'update_yuktdhara_received.py','exec')
            received_script.write_text(latest+'\n',encoding='utf-8')
            print('Latest Yuktdhara GP updater loaded from GitHub.',flush=True)
        except Exception as e:
            print('Using bundled Yuktdhara GP updater: '+str(e),flush=True)
        jobs=[(updater,[]),('scripts_local/update_muster_emb_monitoring.py',['--update-only']),('scripts_local/update_shramik_niyojan.py',[]),('scripts_local/update_yuktdhara_monitoring.py',['--update-only']),('scripts_local/update_satna_block_statistics.py',[]),('scripts_local/update_shramik_state.py',[]),('scripts_local/update_yuktdhara_received.py',[])]
        for name,args in jobs:
            if not (repo/name).is_file(): raise RuntimeError('Required updater missing: '+name)
        run_started=datetime.datetime.now(datetime.timezone.utc)
        try:
            for n,(name,args) in enumerate(jobs,1):
                print('['+str(n)+'/7] '+name,flush=True)
                run([sys.executable,str(repo/name),*args],repo)
            for name in ['scripts/merge_official_summary.py','scripts/build_dashboard_data.py','build_dashboard_data.py']:
                if (repo/name).is_file(): run([sys.executable,str(repo/name)],repo)
            state_status=json.loads((repo/'shramik-state-refresh-status.js').read_text(encoding='utf-8-sig').split('=',1)[1].strip().rstrip(';'))
            for flag in ('success','labourSuccess','gpSuccess','persondaysSuccess','ongoingSuccess'):
                if state_status.get(flag) is not True:
                    raise RuntimeError('52-district source refresh incomplete: '+flag+'; '+str(state_status.get('warnings',state_status.get('message',''))))
            state_data=json.loads((repo/'shramik-district-reports.js').read_text(encoding='utf-8-sig').split('=',1)[1].strip().rstrip(';'))
            if len(state_data.get('districts',{}))!=52: raise RuntimeError('Expected 52 district rows.')
            today=datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=5,minutes=30))).strftime('%d-%m-%Y')
            if state_data.get('ongoingDate')!=today:
                raise RuntimeError('52-district ongoing works are not verified for today. Data date: '+str(state_data.get('ongoingDate'))+'; required: '+today)
            def read_payload(name):
                raw=(repo/name).read_text(encoding='utf-8-sig')
                return json.loads(raw.split('=',1)[1].strip().rstrip(';'))
            for name in ('shramik-niyojan-data.js','vbg-block-stats.js','muster-emb-data.js','shramik-district-reports.js'):
                payload=read_payload(name)
                stamp=payload.get('updatedAt')
                if not stamp or datetime.datetime.fromisoformat(stamp.replace('Z','+00:00'))<run_started:
                    raise RuntimeError('Stale output was retained: '+name)
            local=read_payload('shramik-niyojan-data.js')
            if len(local.get('rows',[]))!=8 or len(local.get('engineerRows',[]))!=59 or len(local.get('gpMandaysRows',[]))!=695:
                raise RuntimeError('Expected 8 Janpads, 59 engineers and 695 GP manday rows.')
            if local.get('officialDate','').replace('/','-')!=today:
                raise RuntimeError('Local Persondays report is not dated today.')
            fetch=json.loads((repo/'data/fetch-status.json').read_text(encoding='utf-8-sig'))
            if fetch.get('ok') is not True or fetch.get('officialDate')!=today:
                raise RuntimeError('R6.9 source status not verified for today.')
            state_labour=sum(d['rows'][0]['todayLabour'] for d in state_data['districts'].values())
            state_gp=sum(d['rows'][0]['workingGP'] for d in state_data['districts'].values())
            print('52 districts verified. Labour: '+str(state_labour)+'; GPs with work in progress: '+str(state_gp),flush=True)
            if not (repo/'index.html').is_file(): raise RuntimeError('index.html missing.')
            for name in FILES:
                f=repo/name
                if not f.is_file() or f.stat().st_size==0: raise RuntimeError('Generated file missing or empty: '+name)
                if f.suffix=='.js' and any(line.startswith(('<<<<<<< ','=======','>>>>>>> ')) for line in f.read_text(encoding='utf-8-sig').splitlines()):
                    raise RuntimeError('Conflict markers in '+name)
                (snapshot/name).parent.mkdir(parents=True,exist_ok=True)
                shutil.copy2(f,snapshot/name)
        except Exception:
            for name in FILES:
                if existed[name]: shutil.copy2(before/name,repo/name)
                else: (repo/name).unlink(missing_ok=True)
            print('Update failed: previous listed data files restored; nothing published.',flush=True)
            raise
        publish(repo,snapshot,FILES,gitdir)
        print('DATA FETCH AND GITHUB PUBLISH COMPLETE. GitHub Pages deployment is separate.\nOpen https://srdmsatna.online after deployment and press Ctrl+F5.',flush=True)
    finally:
        lock.rmdir()

if __name__=='__main__':
    try: main(sys.argv[2])
    except Exception as e:
        print('\nERROR: '+str(e)+'\nUPDATE NOT CONFIRMED. No force push was used.',flush=True)
        sys.exit(1)
